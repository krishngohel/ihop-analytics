# Copy to .env (git-ignored). Nothing here belongs in code or in the repository.
PORT=4000
# OPS_DB_PATH=C:\data\ops.db

# --- Automatic data inputs: use whichever the vendor system supports ---

# 1) Watched folder: scheduled CSV/Excel exports dropped here are imported on every refresh.
# IMPORT_DIR=import

# 2) Reports mailbox: have Rosnet email the scheduled reports to a dedicated inbox.
#    Use an app password for a mailbox that exists only for this. Not a Rosnet login.
# REPORTS_IMAP_HOST=imap.gmail.com
# REPORTS_IMAP_PORT=993
# REPORTS_IMAP_USER=ihop-reports@example.com
# REPORTS_IMAP_PASSWORD=
# REPORTS_IMAP_FOLDER=INBOX
# REPORTS_ALLOWED_SENDERS=rosnet.com

# 3) Push endpoint: POST /api/ingest with "Authorization: Bearer <token>". Long random value.
# INGEST_TOKEN=

# COOKIE_SECURE=1
