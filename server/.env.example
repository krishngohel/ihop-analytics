# Optional. The installed app needs none of this: connections are set up in the dashboard
# (Data and refresh > Connections). These are for hosted installs that prefer environment
# variables; a variable set here wins over the value saved in the dashboard.
# Copy to .env (git-ignored). Nothing here belongs in code or in the repository.
PORT=4000
# OPS_DB_PATH=C:\data\ops.db

# --- Automatic data inputs: use whichever the vendor system supports ---

# 0) Rosnet API (preferred): https://api.rosnet.com, documented at /swagger/v1/swagger.json.
#    Email api@rosnet.com for an API User ID and Key. These are NOT a Rosnet website sign-in:
#    never put a person's Rosnet username or password here or anywhere else in this project.
#    Pulls net sales (live and final), last-year sales, worked and scheduled labor, store list.
# ROSNET_API_USER=
# ROSNET_API_KEY=
#    Only for a key that covers several Rosnet client sites:
# ROSNET_CLIENT_ID=
#    Days of history to load on the first run (default 35):
# ROSNET_BACKFILL_DAYS=35

# 0b) Rosnet portal sign-in (bridge until an API key exists): the dashboard signs in the way
#     the website does and reads the same data widgets. Only works while the account has no MFA.
#     Normally entered in the dashboard (Data and refresh > Connections), not here.
# ROSNET_PORTAL_USER=
# ROSNET_PORTAL_PASSWORD=
# ROSNET_PORTAL_CLIENT=ACGTX
# ROSNET_PORTAL_CLIENT_ID=95
#    Job names counted as manager hours (regular expression, default below):
# ROSNET_MANAGER_JOBS=manager|\bmgr\b|\bgm\b|\bagm\b

# 1) Watched folder: scheduled CSV/Excel exports dropped here are imported on every refresh.
# IMPORT_DIR=import

# 2) Reports mailbox: have Rosnet email the scheduled reports to a dedicated inbox.
#    Use an app password for a mailbox that exists only for this. Not a Rosnet login.
# REPORTS_IMAP_HOST=imap.gmail.com
# REPORTS_IMAP_PORT=993
# REPORTS_IMAP_USER=ihop-reports@example.com
# REPORTS_IMAP_PASSWORD=
# REPORTS_IMAP_FOLDER=INBOX
# REPORTS_ALLOWED_SENDERS=rosnet.com

# 3) Push endpoint: POST /api/ingest with "Authorization: Bearer <token>". Long random value.
# INGEST_TOKEN=

# COOKIE_SECURE=1
